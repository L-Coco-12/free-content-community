# 复制成 .env 后修改所有 change-me 值
# 密码建议使用字母、数字、- 和 _，避免 $ # 等会被 Compose 解析的字符

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=free_content
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380

# 邮箱验证码 HMAC / AES-GCM 密钥（32字节随机值的Base64）
# 以下仅为本地开发示例，生产必须用 `openssl rand -base64 32` 重新生成两个不同值
EMAIL_CHALLENGE_MAC_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
EMAIL_CHALLENGE_ENCRYPTION_KEY_BASE64=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=

# 浏览器跨域来源（逗号分隔）；默认允许 Vite 与 nginx 本地入口
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me-mq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=free-content
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1

# 上传策略（后端 app.media.upload-policy，MIME列表用逗号分隔）
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=524288000
MEDIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4
MEDIA_MULTIPART_THRESHOLD_BYTES=16777216
MEDIA_MAX_PART_COUNT=10000
MEDIA_UPLOAD_URL_TTL_SECONDS=600

# 上传会话创建（后端 app.media.upload-creation）
MEDIA_UPLOAD_SESSION_TTL_SECONDS=7200
MEDIA_UPLOAD_IP_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_USER_HOURLY_LIMIT=100
MEDIA_UPLOAD_REDIS_KEY_PREFIX=fc:media:

# 上传查询与续签（后端 app.media.upload-query，独立分钟窗口）
MEDIA_UPLOAD_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_QUERY_REDIS_KEY_PREFIX=fc:media:

# 取消上传（独立分钟窗口）
MEDIA_UPLOAD_CANCEL_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_CANCEL_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_CANCEL_REDIS_KEY_PREFIX=fc:media:

# 完成上传（独立分钟窗口，包含幂等重放）
MEDIA_UPLOAD_COMPLETION_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_COMPLETION_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_COMPLETION_REDIS_KEY_PREFIX=fc:media:
MEDIA_UPLOAD_COMPLETION_RETRY_AFTER_SECONDS=2

# 本人媒体任务查询（独立分钟窗口）
MEDIA_TASK_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_TASK_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_TASK_QUERY_REDIS_KEY_PREFIX=fc:media:

# 本人素材校验结果查询（独立分钟窗口）
MEDIA_ASSET_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_ASSET_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_ASSET_QUERY_REDIS_KEY_PREFIX=fc:media:

# 已取消上传的后台回收（原会话到期时间 + 缓冲后清理）
MEDIA_UPLOAD_CLEANUP_ENABLED=true
MEDIA_UPLOAD_CLEANUP_GRACE_SECONDS=600
MEDIA_UPLOAD_CLEANUP_POLL_DELAY_MILLIS=1000
MEDIA_UPLOAD_CLEANUP_LEASE_SECONDS=60
MEDIA_UPLOAD_CLEANUP_MAX_ATTEMPTS=3
MEDIA_UPLOAD_CLEANUP_RETRY_BASE_SECONDS=5

# 图片自动校验；任务认领租约覆盖存储 I/O 与解码预算
MEDIA_PROCESSING_ENABLED=true
MEDIA_PROCESSING_POLL_DELAY_MILLIS=1000
MEDIA_PROCESSING_LEASE_SECONDS=120
MEDIA_PROCESSING_MAX_ATTEMPTS=3
MEDIA_PROCESSING_RETRY_BASE_SECONDS=5
MEDIA_PROCESSING_ORPHAN_GRACE_SECONDS=120
MEDIA_PROCESSING_MAX_WIDTH=8192
MEDIA_PROCESSING_MAX_HEIGHT=8192
MEDIA_PROCESSING_MAX_FRAME_PIXELS=25000000
MEDIA_PROCESSING_MAX_FRAMES=100
MEDIA_PROCESSING_MAX_TOTAL_PIXELS=100000000
MEDIA_PROCESSING_DECODE_TIMEOUT_SECONDS=30

# 可信反向代理网段（可选；默认信任本机与私网。生产按实际代理网段覆盖正则）
# TRUSTED_PROXY_PATTERN=10\.0\.0\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}

# 创建内容及首个草稿（app.content.creation；成功幂等重放免计配额）
CONTENT_CREATION_IP_PER_MINUTE_LIMIT=60
CONTENT_CREATION_USER_HOURLY_LIMIT=100
CONTENT_CREATION_REDIS_KEY_PREFIX=fc:content:

# 本人创作列表、工作区与审核查询（app.content.query；共享来源和用户分钟窗口）
CONTENT_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_QUERY_REDIS_KEY_PREFIX=fc:content:

# 后台审核列表和详情（共享来源/审核人员分钟窗口；独立于本人及标签查询）
CONTENT_ADMIN_REVIEW_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_ADMIN_REVIEW_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_ADMIN_REVIEW_QUERY_REDIS_KEY_PREFIX=fc:content:

# 后台审核媒体预览（独立签名申请额度；默认5分钟，敏感预览写审计）
CONTENT_ADMIN_REVIEW_MEDIA_PREVIEW_READ_URL_TTL_SECONDS=300
CONTENT_ADMIN_REVIEW_MEDIA_PREVIEW_IP_PER_MINUTE_LIMIT=120
CONTENT_ADMIN_REVIEW_MEDIA_PREVIEW_USER_PER_MINUTE_LIMIT=60
CONTENT_ADMIN_REVIEW_MEDIA_PREVIEW_REDIS_KEY_PREFIX=fc:content:

# 保存当前草稿（app.content.draft-save；同值与冲突请求也计数）
CONTENT_DRAFT_SAVE_IP_PER_MINUTE_LIMIT=120
CONTENT_DRAFT_SAVE_USER_PER_MINUTE_LIMIT=60
CONTENT_DRAFT_SAVE_REDIS_KEY_PREFIX=fc:content:

# 从历史修订创建新草稿，成功幂等重放免配额。
CONTENT_DRAFT_CREATION_IP_PER_MINUTE_LIMIT=60
CONTENT_DRAFT_CREATION_USER_HOURLY_LIMIT=100
CONTENT_DRAFT_CREATION_REDIS_KEY_PREFIX=fc:content:

# 本人修订媒体预览（独立签名申请额度；结果对象GET地址有效5分钟）
CONTENT_MEDIA_PREVIEW_READ_URL_TTL_SECONDS=300
CONTENT_MEDIA_PREVIEW_IP_PER_MINUTE_LIMIT=120
CONTENT_MEDIA_PREVIEW_USER_PER_MINUTE_LIMIT=60
CONTENT_MEDIA_PREVIEW_REDIS_KEY_PREFIX=fc:content:

# 提交当前草稿审核（独立来源分钟/用户小时窗口；成功幂等重放免额度）
CONTENT_REVIEW_SUBMISSION_IP_PER_MINUTE_LIMIT=60
CONTENT_REVIEW_SUBMISSION_USER_HOURLY_LIMIT=100
CONTENT_REVIEW_SUBMISSION_REDIS_KEY_PREFIX=fc:content:

# 批准/驳回修订（独立来源分钟/审核人员小时窗口；成功幂等重放免额度）
CONTENT_REVIEW_DECISION_IP_PER_MINUTE_LIMIT=60
CONTENT_REVIEW_DECISION_USER_HOURLY_LIMIT=100
CONTENT_REVIEW_DECISION_REDIS_KEY_PREFIX=fc:content:

# 撤销本人待审核申请（独立来源/用户分钟窗口；重复撤销也计数）
CONTENT_REVIEW_CANCELLATION_IP_PER_MINUTE_LIMIT=120
CONTENT_REVIEW_CANCELLATION_USER_PER_MINUTE_LIMIT=60
CONTENT_REVIEW_CANCELLATION_REDIS_KEY_PREFIX=fc:content:

# 作者撤回公开内容；合法重复204同样计数。
CONTENT_PUBLICATION_WITHDRAWAL_IP_PER_MINUTE_LIMIT=120
CONTENT_PUBLICATION_WITHDRAWAL_USER_PER_MINUTE_LIMIT=60
CONTENT_PUBLICATION_WITHDRAWAL_REDIS_KEY_PREFIX=fc:content:

# 管理员创建标签（app.tag.creation，独立来源分钟/管理员小时窗口）
TAG_CREATION_IP_PER_MINUTE_LIMIT=60
TAG_CREATION_USER_HOURLY_LIMIT=100
TAG_CREATION_REDIS_KEY_PREFIX=fc:tag:

# 管理员标签查询（app.tag.query，列表与详情共享分钟窗口）
TAG_QUERY_IP_PER_MINUTE_LIMIT=120
TAG_QUERY_USER_PER_MINUTE_LIMIT=60
TAG_QUERY_REDIS_KEY_PREFIX=fc:tag:

# 管理员修改/停用标签（app.tag.update，独立来源分钟/管理员小时窗口）
TAG_UPDATE_IP_PER_MINUTE_LIMIT=60
TAG_UPDATE_USER_HOURLY_LIMIT=100
TAG_UPDATE_REDIS_KEY_PREFIX=fc:tag:

# 公开有效标签查询（app.tag.active-query，独立来源分钟窗口）
TAG_ACTIVE_QUERY_IP_PER_MINUTE_LIMIT=120
TAG_ACTIVE_QUERY_REDIS_KEY_PREFIX=fc:tag:

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAIL_SMTP_CONNECTION_TIMEOUT_MILLIS=3000
MAIL_SMTP_READ_TIMEOUT_MILLIS=5000
MAIL_SMTP_WRITE_TIMEOUT_MILLIS=5000

# Elasticsearch（P1，profile=search）
ES_PORT=9200

# 已发布内容公开详情：来源共享窗口；登录用户额外计算账号窗口
CONTENT_PUBLIC_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_PUBLIC_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_PUBLIC_QUERY_REDIS_KEY_PREFIX=fc:content:

# 本人关注流使用独立读配额，沿用公开内容游标的密钥和期限配置。
CONTENT_FOLLOWING_FEED_IP_PER_MINUTE_LIMIT=120
CONTENT_FOLLOWING_FEED_USER_PER_MINUTE_LIMIT=60
CONTENT_FOLLOWING_FEED_REDIS_KEY_PREFIX=fc:content:

# 点赞与取消点赞共享写入限流；重复成功请求也计数
CONTENT_LIKE_IP_PER_MINUTE_LIMIT=120
CONTENT_LIKE_USER_PER_MINUTE_LIMIT=60
CONTENT_LIKE_REDIS_KEY_PREFIX=fc:content:

# 评论发布与删除共享写入限流，发布的幂等成功重放复用原结果。
CONTENT_COMMENT_IP_PER_MINUTE_LIMIT=120
CONTENT_COMMENT_USER_PER_MINUTE_LIMIT=60
CONTENT_COMMENT_REDIS_KEY_PREFIX=fc:content:

# 公开评论查询独立限流；游客只使用来源配额。
CONTENT_COMMENT_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_COMMENT_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_COMMENT_QUERY_REDIS_KEY_PREFIX=fc:content:

# 运营评论查询使用独立的来源和账号配额。
CONTENT_COMMENT_ADMIN_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_COMMENT_ADMIN_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_COMMENT_ADMIN_QUERY_REDIS_KEY_PREFIX=fc:content:

# 隐藏评论使用独立写入配额，成功幂等重放复用原处置结果。
CONTENT_COMMENT_HIDE_IP_PER_MINUTE_LIMIT=120
CONTENT_COMMENT_HIDE_USER_PER_MINUTE_LIMIT=60
CONTENT_COMMENT_HIDE_REDIS_KEY_PREFIX=fc:content:

# 举报提交按账号和来源限流，成功的幂等重放沿用原回执。
REPORT_SUBMISSION_IP_PER_MINUTE_LIMIT=120
REPORT_SUBMISSION_USER_PER_MINUTE_LIMIT=60
REPORT_SUBMISSION_REDIS_KEY_PREFIX=fc:report:

# 本人举报查询使用独立的账号和来源配额。
REPORT_QUERY_IP_PER_MINUTE_LIMIT=120
REPORT_QUERY_USER_PER_MINUTE_LIMIT=60
REPORT_QUERY_REDIS_KEY_PREFIX=fc:report:

# 运营举报查询使用独立的账号和来源配额。
REPORT_ADMIN_QUERY_IP_PER_MINUTE_LIMIT=120
REPORT_ADMIN_QUERY_USER_PER_MINUTE_LIMIT=60
REPORT_ADMIN_QUERY_REDIS_KEY_PREFIX=fc:report:

# 举报附件签名使用独立的账号和来源配额。
REPORT_ATTACHMENT_ACCESS_READ_URL_TTL_SECONDS=300
REPORT_ATTACHMENT_ACCESS_IP_PER_MINUTE_LIMIT=120
REPORT_ATTACHMENT_ACCESS_USER_PER_MINUTE_LIMIT=60
REPORT_ATTACHMENT_ACCESS_REDIS_KEY_PREFIX=fc:report:

# 举报处理使用独立的账号和来源配额，已完成的幂等请求直接重放。
REPORT_DECISION_IP_PER_MINUTE_LIMIT=120
REPORT_DECISION_USER_PER_MINUTE_LIMIT=60
REPORT_DECISION_REDIS_KEY_PREFIX=fc:report:

# 收藏与取消收藏共享写入限流；重复成功请求也计数
CONTENT_BOOKMARK_IP_PER_MINUTE_LIMIT=120
CONTENT_BOOKMARK_USER_PER_MINUTE_LIMIT=60
CONTENT_BOOKMARK_REDIS_KEY_PREFIX=fc:content:
CONTENT_BOOKMARK_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_BOOKMARK_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_BOOKMARK_QUERY_REDIS_KEY_PREFIX=fc:content:

# 公开发布媒体的短时读取，签名配额独立于内容浏览。
CONTENT_PUBLIC_MEDIA_ACCESS_READ_URL_TTL_SECONDS=300
CONTENT_PUBLIC_MEDIA_ACCESS_IP_PER_MINUTE_LIMIT=120
CONTENT_PUBLIC_MEDIA_ACCESS_USER_PER_MINUTE_LIMIT=60
CONTENT_PUBLIC_MEDIA_ACCESS_REDIS_KEY_PREFIX=fc:content:

# 公开个人主页独立配额；不与公开内容浏览共享窗口。
USER_PUBLIC_QUERY_IP_PER_MINUTE_LIMIT=120
USER_PUBLIC_QUERY_USER_PER_MINUTE_LIMIT=60
USER_PUBLIC_QUERY_REDIS_KEY_PREFIX=fc:user:

# 关注与取消关注共享配额，重复请求也计入请求次数。
USER_FOLLOW_IP_PER_MINUTE_LIMIT=120
USER_FOLLOW_USER_PER_MINUTE_LIMIT=60
USER_FOLLOW_REDIS_KEY_PREFIX=fc:user:

# 本人关注列表独立读配额。游标密钥未设置时使用公开内容游标密钥。
USER_FOLLOW_QUERY_IP_PER_MINUTE_LIMIT=120
USER_FOLLOW_QUERY_USER_PER_MINUTE_LIMIT=60
USER_FOLLOW_QUERY_REDIS_KEY_PREFIX=fc:user:
USER_FOLLOW_QUERY_CURSOR_TTL_SECONDS=900
# USER_FOLLOW_QUERY_CURSOR_KEY_BASE64: optional 32-byte Base64 key.

USER_SESSION_QUERY_IP_PER_MINUTE_LIMIT=120
USER_SESSION_QUERY_USER_PER_MINUTE_LIMIT=60
USER_SESSION_QUERY_REDIS_KEY_PREFIX=fc:user:
USER_ROLE_QUERY_IP_PER_MINUTE_LIMIT=120
USER_ROLE_QUERY_USER_PER_MINUTE_LIMIT=60
USER_ROLE_QUERY_REDIS_KEY_PREFIX=fc:user:
USER_ADMIN_QUERY_IP_PER_MINUTE_LIMIT=120
USER_ADMIN_QUERY_USER_PER_MINUTE_LIMIT=60
USER_ADMIN_QUERY_REDIS_KEY_PREFIX=fc:user:
USER_RESTRICTION_IP_PER_MINUTE_LIMIT=120
USER_RESTRICTION_USER_PER_MINUTE_LIMIT=60
USER_RESTRICTION_REDIS_KEY_PREFIX=fc:user:
USER_ROLE_UPDATE_IP_PER_MINUTE_LIMIT=120
USER_ROLE_UPDATE_USER_PER_MINUTE_LIMIT=60
USER_ROLE_UPDATE_REDIS_KEY_PREFIX=fc:user:
USER_SESSION_REVOCATION_IP_PER_MINUTE_LIMIT=120
USER_SESSION_REVOCATION_USER_PER_MINUTE_LIMIT=60
USER_SESSION_REVOCATION_REDIS_KEY_PREFIX=fc:user:

# 公开头像：稳定业务地址跳转到短期 READY 对象地址
USER_AVATAR_READ_URL_TTL_SECONDS=300
USER_AVATAR_IP_PER_MINUTE_LIMIT=120
USER_AVATAR_USER_PER_MINUTE_LIMIT=60
USER_AVATAR_REDIS_KEY_PREFIX=fc:user:
# 留空使用请求根地址；HTTPS反向代理部署时配置外部根地址，可含上下文路径
USER_AVATAR_PUBLIC_BASE_URL=

# 公开列表游标：首次请求起固定15分钟；生产环境替换为独立随机32字节Base64密钥，各实例保持一致。
CONTENT_PUBLIC_CURSOR_TTL_SECONDS=900
NOTIFICATION_CURSOR_TTL_SECONDS=900
# NOTIFICATION_CURSOR_KEY_BASE64: optional 32-byte Base64 key; uses CONTENT_PUBLIC_CURSOR_KEY_BASE64 if unset.
NOTIFICATION_QUERY_IP_PER_MINUTE_LIMIT=120
NOTIFICATION_QUERY_USER_PER_MINUTE_LIMIT=60
NOTIFICATION_QUERY_REDIS_KEY_PREFIX=fc:notification:
NOTIFICATION_READ_IP_PER_MINUTE_LIMIT=120
NOTIFICATION_READ_USER_PER_MINUTE_LIMIT=60
NOTIFICATION_READ_REDIS_KEY_PREFIX=fc:notification:
CONTENT_PUBLIC_CURSOR_KEY_BASE64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# 重新公开独立配额；同版重复成功也计数。
CONTENT_PUBLICATION_REPUBLISH_IP_PER_MINUTE_LIMIT=120
CONTENT_PUBLICATION_REPUBLISH_USER_PER_MINUTE_LIMIT=60
CONTENT_PUBLICATION_REPUBLISH_REDIS_KEY_PREFIX=fc:content:

# 移入回收站独立配额；合法重复204也计数。
CONTENT_DELETION_IP_PER_MINUTE_LIMIT=120
CONTENT_DELETION_USER_PER_MINUTE_LIMIT=60
CONTENT_DELETION_REDIS_KEY_PREFIX=fc:content:

# 回收站恢复独立配额；成功幂等重放免配额。
CONTENT_RESTORATION_IP_PER_MINUTE_LIMIT=60
CONTENT_RESTORATION_USER_HOURLY_LIMIT=100
CONTENT_RESTORATION_REDIS_KEY_PREFIX=fc:content:

# 后台内容查询独立配额；不与审核待办共享窗口。
CONTENT_ADMIN_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_ADMIN_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_ADMIN_QUERY_REDIS_KEY_PREFIX=fc:content:

# 运营处置详情使用独立的来源和账号读配额。
CONTENT_MODERATION_QUERY_IP_PER_MINUTE_LIMIT=120
CONTENT_MODERATION_QUERY_USER_PER_MINUTE_LIMIT=60
CONTENT_MODERATION_QUERY_REDIS_KEY_PREFIX=fc:content:

# 强制下架独立配额；成功幂等重放免配额。
CONTENT_TAKE_DOWN_IP_PER_MINUTE_LIMIT=60
CONTENT_TAKE_DOWN_USER_HOURLY_LIMIT=100
CONTENT_TAKE_DOWN_REDIS_KEY_PREFIX=fc:content:
